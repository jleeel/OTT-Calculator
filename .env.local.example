# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
#   cp .env.local.example .env.local
#
# Values come from your Supabase project dashboard:
#   Project Settings -> Data API   (URL)
#   Project Settings -> API Keys   (anon / service_role)

# ---------------------------------------------------------------------------
# Public — inlined into the browser bundle at build time.
# Anything prefixed NEXT_PUBLIC_ is readable by anyone who loads the site.
# Never put a secret behind this prefix.
# ---------------------------------------------------------------------------

# Your project's REST endpoint, e.g. https://abcdefghijklm.supabase.co
#
# This is the "Project URL" under Project Settings -> Data API. It is NOT the
# address of the dashboard page you are looking at (supabase.com/dashboard/...).
# No trailing slash and no path — the client appends /rest/v1 itself. A wrong
# value here took the live leaderboard down once; src/lib/supabase/url.ts now
# corrects what it can and names this variable when it cannot.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable "anon" key. Safe to expose: every request it makes is filtered by
# Row Level Security, so RLS policies are what actually protect the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only — must NOT be prefixed NEXT_PUBLIC_.
# Only ever imported from route handlers, server actions, and server
# components (see src/lib/supabase/server.ts, which is marked `server-only`).
# ---------------------------------------------------------------------------

# service_role key. Bypasses Row Level Security completely — it can read and
# write every row in the database. Treat it like a database password: keep it
# out of git, out of client components, and out of any response body.
SUPABASE_SERVICE_ROLE_KEY=

# Shared passcode required to write to the leaderboard, so submissions have to
# come through this app's own API routes. Generate one with:
#   openssl rand -base64 32
LEADERBOARD_PASSCODE=

# Passcode for admin actions — removing entries, resolving plausibility flags,
# season rollover. Server-only. Not read by anything yet; wired up in a later
# pass. Keep it distinct from LEADERBOARD_PASSCODE.
ADMIN_PASSCODE=

# Anthropic API key, used by /api/diagnose to read plant photos. Server-only —
# it must never reach the browser, so it is read in the route handler and
# nowhere else. Without it, /diagnose loads and says plant help is switched off.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Absolute URL of the deployment, used for canonical links and metadata.
# Locally this is http://localhost:3000; on Vercel, your production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
